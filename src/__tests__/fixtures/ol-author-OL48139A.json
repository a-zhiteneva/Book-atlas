se:bwb_daily_pallets_2023-01-05", "bwb:9798371467720", "promise:bwb_daily_pallets_2022-08-13:O8-CRQ-816", "amazon:605375353X", "bwb:9780141939704", "amazon:0141032901", "promise:bwb_daily_pallets_2022-10-17:W7-BMY-565", "promise:bwb_daily_pallets_2022-10-12:O8-CYO-074", "promise:bwb_daily_pallets_2022-07-11:KR-030-797", "amazon:8377589842", "promise:bwb_daily_pallets_2023-04-10:P8-CZB-333", "promise:bwb_daily_pallets_2023-05-15:O7-DBS-276", "marc:marc_columbia/Columbia-extract-20221130-007.mrc:454215521:1203", "promise:bwb_daily_pallets_2023-12-04:O9-CFB-849", "promise:bwb_daily_pallets_2024-01-18:P9-CYN-758", "promise:bwb_daily_pallets_2024-03-27:P9-EBM-687", "bwb:9781494428945", "ia:adaorardorafamil0000vlad", "ia:bwb_S0-AGO-068", "ia:bwb_W9-CEW-867"], "death_date": "2 July 1977", "bio": {"type": "/type/text", "value": "Vladimir Vladimirovich Nabokov (Russian: \u0412\u043b\u0430\u0434\u0438\u0301\u043c\u0438\u0440 \u0412\u043b\u0430\u0434\u0438\u0301\u043c\u0438\u0440\u043e\u0432\u0438\u0447 \u041d\u0430\u0431\u043e\u0301\u043a\u043e\u0432; 23 April [O.S. 10 April] 1899c \u2013 2 July 1977) was a multilingual Russian-American novelist and short story writer. Nabokov wrote his first nine novels in Russian, then rose to international prominence as a master English prose stylist. He also made contributions to entomology and had an interest in chess problems.\r\n\r\nNabokov's *Lolita* (1955) is frequently cited as among his most important novels and is his most widely known, exhibiting the love of intricate word play and synesthetic detail that characterised all his works. The novel was ranked at #4 in the list of the Modern Library 100 Best Novels. *Pale Fire* (1962) was ranked at #53 on the same list. His memoir entitled *Speak, Memory* was listed #8 on the Modern Library nonfiction list. ([Source][1].)\r\n\r\n[1]:https://en.wikipedia.org/wiki/Vladimir_Nabokov"}, "photos": [15115197, 15115196, 6388127, 15115195], "type": {"key": "/type/author"}, "latest_revision": 40, "revision": 40, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-23T15:14:30.544138"}}